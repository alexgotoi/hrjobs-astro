---
// src/layouts/Base.astro
import "../styles/global.css";
import { organizationSchema, websiteSchema, jsonLd } from "../lib/schema.mjs";
import { ALL_CATEGORIES, catSlug, excelLink } from "../lib/util.mjs";

const {
  title,
  description,
  canonical,
  image,
  noindex = false,
  schemas = [],        // array of page-specific JSON-LD objects
  ogType = "website",
  wide = false,        // wide layout (e.g. the two-column job page)
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") || "";
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image || `${site}/og-default.png`;

// External links used in the menu/footer. Employer CTAs now route through the on-site
// /post-a-job landing page (not straight to a form), so there's no add-a-job form URL here.
const EXCEL_MENU = excelLink("menu");
const EXCEL_FOOTER = excelLink("footer");
// The newsletter capture BAND posts to our own Netlify function, which adds the email to
// the EmailOctopus list (netlify/functions/subscribe.mjs; needs EMAILOCTOPUS_API_KEY and
// EMAILOCTOPUS_LIST_ID set in Netlify). The email field is named "email".
const NEWSLETTER_ACTION = "/api/subscribe";
// The "Newsletter" menu/footer links go to the newsletter page (src/pages/newsletter.astro).
const NEWSLETTER_URL = "/newsletter";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Favicons / app icons (generated from the brand logo in public/) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f0b45a" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex
      ? <meta name="robots" content="noindex,follow" />
      : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="HRJobsRemote" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- display font, limited, swap for good CWV -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&display=swap"
    />

    <!-- Fathom Analytics (privacy-friendly, no cookie banner needed). Counts only the real
         domain, so Netlify preview builds don't pollute the stats. -->
    <script is:inline src="https://cdn.usefathom.com/script.js" data-site="KMZHZQYY" data-included-domains="www.hrjobsremote.com,hrjobsremote.com" defer></script>

    <!-- Sitewide schema: Organization + WebSite (enables a search box in Google) -->
    <script type="application/ld+json" set:html={jsonLd(organizationSchema())} />
    <script type="application/ld+json" set:html={jsonLd(websiteSchema())} />
    <!-- page-specific schema -->
    {schemas.filter(Boolean).map((s) => (
      <script type="application/ld+json" set:html={jsonLd(s)} />
    ))}
  </head>
  <body>
    <header class="site-header">
      <div class="nav-row">
        <div class="wrap wrap-wide">
          <a class="brand" href="/">HRJobs<b>Remote</b></a>
          <nav class="nav">
            <a href="/resources">Resources</a>
            <a href={NEWSLETTER_URL}>Newsletter</a>
            <a href={EXCEL_MENU} target="_blank" rel="noopener">Excel for HR</a>
            <a class="btn-add" href="/post-a-job">Post a job</a>
          </nav>
        </div>
      </div>
    </header>

    <section class="nl-band" id="subscribe" aria-label="Remote HR jobs newsletter">
      <div class={`wrap wrap-wide nl-wrap ${Astro.slots.has("hero") ? "nl-has-hero" : ""}`}>
        {Astro.slots.has("hero") && <div class="nl-hero"><slot name="hero" /></div>}
        <div class="nl-inner">
          <p class="nl-proof">Join <b>16,000+</b> HR professionals getting new remote jobs <b>every week</b></p>
          <div class="nl-cta">
            <form class="nl-form" action={NEWSLETTER_ACTION} method="post">
              <input type="email" name="email" required placeholder="Your email" aria-label="Email address" autocomplete="email" />
              <!-- honeypot: hidden from people, bots fill it in -->
              <input type="text" name="company" class="nl-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <button type="submit">Subscribe</button>
            </form>
            <span class="nl-note" role="status" aria-live="polite">No spam. Unsubscribe anytime.</span>
          </div>
        </div>
      </div>
    </section>

    <main class={`wrap ${wide ? "wrap-wide" : ""}`}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap wrap-wide">
        <div class="cols">
          <div>
            <a class="brand" href="/">HRJobs<b>Remote</b></a>
            <p class="tagline">Hand-picked remote jobs for HR professionals — recruiters, HRBPs, people-ops and more.</p>
          </div>
          <div>
            <h4>Remote jobs by category</h4>
            <ul>
              {ALL_CATEGORIES.map((c) => (
                <li><a href={`/${catSlug(c)}`}>{c} remote jobs</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h4>Resources</h4>
            <ul>
              <li><a href="/resources">HR career resources</a></li>
              <li><a href="/salary-guides">HR salary guides</a></li>
              <li><a href="/collections">Job collections</a></li>
              <li><a href="/blog">Articles &amp; guides</a></li>
            </ul>
          </div>
          <div>
            <h4>More</h4>
            <ul>
              <li><a href="/">All remote HR jobs</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="/companies">Browse companies</a></li>
              <li><a href="/post-a-job">Post a job (employers)</a></li>
              <li><a href={NEWSLETTER_URL}>Newsletter</a></li>
              <li><a href={EXCEL_FOOTER} target="_blank" rel="noopener">Excel for HR (course)</a></li>
            </ul>
          </div>
        </div>
        <div class="legal">© {new Date().getFullYear()} HRJobsRemote · Remote HR jobs since 2019</div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var h = document.querySelector(".site-header");
        var set = function () {
          document.documentElement.style.setProperty("--header-h", ((h && h.offsetHeight) || 64) + "px");
        };
        set();
        window.addEventListener("resize", set);
      })();

      // Newsletter band: submit in place (no page change) and confirm under the form.
      // Without JS the form still posts normally and lands on /subscribed.
      document.querySelectorAll(".nl-form").forEach(function (form, i) {
        var note = form.parentElement.querySelector(".nl-note");
        if (!note || !window.fetch) return;
        var show = function (msg, state) { note.textContent = msg; note.setAttribute("data-state", state); };
        if (i === 0 && /[?&]subscribe=error/.test(location.search)) show("Something went wrong. Please try again.", "error");
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var btn = form.querySelector("button");
          btn.disabled = true;
          show("Subscribing…", "busy");
          fetch(form.action, { method: "POST", headers: { Accept: "application/json" }, body: new FormData(form) })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              show(d.message, d.ok ? "ok" : "error");
              if (d.ok) form.reset();
            })
            .catch(function () { show("Something went wrong. Please try again.", "error"); })
            .finally(function () { btn.disabled = false; });
        });
      });
    </script>
  </body>
</html>
